            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "barcode",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "packageSize",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "strength",
            "required": false,
            "in": "query",
            "schema": {
              "example": "400 mg"
            }
          },
          {
            "name": "country",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "prescription",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "RX",
                "OTC",
                "PHARMACY_ONLY"
              ],
              "type": "string"
            }
          },
          {
            "name": "route",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "form",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "atc",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "manufacturer",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "ingredients",
            "required": false,
            "in": "query",
            "description": "Comma-separated active ingredients (all must match)",
            "schema": {}
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
