# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://meddexa:meddexa@localhost:5432/meddexa?schema=public
REDIS_URL=redis://localhost:6379
# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-value-0000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
# Deep-link prefix used in password-reset emails
PUBLIC_APP_URL=meddexa://

# ── Data & behaviour ─────────────────────────────────
PRICE_STALE_DAYS=30
ENABLE_SCHEDULER=true
# Must be false in production (enforced at start-up)
ALLOW_DEMO_DATA=true
RATE_LIMIT_PER_MINUTE=120
THROTTLE_MULTIPLIER=1

# ── Seeding (prisma/seed.ts) ─────────────────────────
SEED_DEMO=true
ADMIN_EMAIL=admin@meddexa.local
ADMIN_PASSWORD=ChangeMe-Admin-2026

# ── Optional integrations ────────────────────────────
SENTRY_DSN=
SMTP_URL=
MAIL_FROM=MedDexa <no-reply@meddexa.app>
GOOGLE_MAPS_API_KEY=
EXPO_ACCESS_TOKEN=
